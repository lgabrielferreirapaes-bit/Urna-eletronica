<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Urna da Resenha — Simulador fictício</title>
<style>
*{box-sizing:border-box}body{margin:0;padding:10px;background:#e8edf2;color:#17212b;font-family:Arial,system-ui,sans-serif;display:flex;justify-content:center}.machine{width:min(100%,800px);background:#d8dce1;border:1px solid #aab2bc;border-radius:18px;padding:12px;box-shadow:0 10px 28px #0002}.top{display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;padding:4px 5px 12px;font-weight:900}.badge{font-size:.68rem;background:#fff3cd;color:#715400;border-radius:6px;padding:6px 8px}.inside{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(225px,.8fr);gap:12px}.screen{background:#f7f9fc;border:9px solid #252a30;border-radius:10px;padding:14px;min-height:350px;display:flex;flex-direction:column}.screenhead{display:flex;justify-content:space-between;gap:8px;border-bottom:1px solid #bdc7d2;padding-bottom:9px;font-size:.72rem;font-weight:800}.vote-layout{display:flex;gap:12px;align-items:center;margin-top:22px}.info{flex:1;min-width:0}.title{font-size:1.1rem;font-weight:900;margin-bottom:8px}.line{font-size:.85rem;margin:6px 0}.num{font-size:1.2rem;font-weight:900;letter-spacing:.12em}.photo{width:112px;height:132px;border:2px solid #aab4c0;border-radius:4px;background:#e6eaf0;object-fit:cover;display:grid;place-items:center;text-align:center;font-size:.75rem;color:#4b5968;flex-shrink:0}.photo img{width:100%;height:100%;object-fit:cover}.candidate-name{font-size:1rem;font-weight:900;margin-top:8px}.instruction{font-size:.82rem;line-height:1.45;margin:14px 0}.help{margin-top:auto;text-align:center;font-size:.76rem;line-height:1.5}.panel{background:#20252b;border-radius:10px;padding:12px}.brand{color:white;text-align:center;font-size:.8rem;font-weight:900;margin:1px 0 10px}.keys{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.key{height:51px;background:#0d1115;color:#fff;border:1px solid #505861;border-radius:7px;font-size:1.4rem;font-weight:900;box-shadow:0 3px 0 #060708;cursor:pointer;touch-action:manipulation;user-select:none}.key:active{transform:translateY(2px);box-shadow:none}.actions{display:grid;gap:8px;margin-top:13px}.action{height:44px;border:0;border-radius:7px;font-weight:900;cursor:pointer;touch-action:manipulation}.blank{background:#f4f5f6}.correct{background:#ff6b1a}.confirm{background:#26c66b}.message{margin-top:10px;padding:10px;border-radius:7px;background:white;min-height:55px;font-size:.82rem;line-height:1.4}.bottom{display:flex;gap:8px;flex-wrap:wrap;margin-top:11px}.bottom button{padding:10px 12px;border:0;border-radius:7px;background:#263746;color:white;font-weight:800;cursor:pointer}.bottom .light{background:white;color:#263746;border:1px solid #aeb8c2}.footer{margin-top:12px;background:white;padding:11px;border-radius:9px;font-size:.81rem;line-height:1.45}@media(max-width:560px){body{padding:6px}.machine{padding:8px}.inside{grid-template-columns:1fr}.screen{min-height:320px}.photo{width:104px;height:125px}.key{height:49px}}
</style>
</head>
<body>
<main class="machine">
<div class="top"><span>🗳️ URNA DA RESENHA</span><span class="badge">SIMULAÇÃO FICTÍCIA • NÃO OFICIAL</span></div>
<div class="inside">
<section class="screen" aria-live="polite">
<div class="screenhead"><span>VOTAÇÃO DE BRINCADEIRA</span><span id="step">TESTE</span></div>
<div class="vote-layout">
<div class="info">
<div class="title" id="heading">SEU VOTO PARA</div>
<div class="line">Número: <span class="num" id="number">_ _</span></div>
<div class="line">Nome:</div><div class="candidate-name" id="name">Digite o número</div>
<div class="line" id="party">Partido: —</div>
</div>
<div class="photo" id="photo" aria-label="Foto ilustrativa do candidato">FOTO DO<br>CANDIDATO</div>
</div>
<p class="instruction" id="instruction">Digite o número de um candidato fictício ou real usado apenas nesta simulação.</p>
<div class="help">CONFIRMA para registrar<br>CORRIGE para apagar • BRANCO para votar em branco</div>
</section>
<section class="panel">
<div class="brand">TECLADO NUMÉRICO</div>
<div class="keys">
<button type="button" class="key" data-n="1">1</button><button type="button" class="key" data-n="2">2</button><button type="button" class="key" data-n="3">3</button>
<button type="button" class="key" data-n="4">4</button><button type="button" class="key" data-n="5">5</button><button type="button" class="key" data-n="6">6</button>
<button type="button" class="key" data-n="7">7</button><button type="button" class="key" data-n="8">8</button><button type="button" class="key" data-n="9">9</button>
<span></span><button type="button" class="key" data-n="0">0</button><span></span>
</div>
<div class="actions"><button type="button" class="action blank" id="blank">BRANCO</button><button type="button" class="action correct" id="correct">CORRIGE</button><button type="button" class="action confirm" id="confirm">CONFIRMA</button></div>
<div class="message" id="message">Teste: digite 01, 13, 22, 67, 69 ou 73. Esta urna não tem validade eleitoral.</div>
</section>
</div>
<div class="bottom"><button type="button" id="results">📊 Apuração fictícia</button><button type="button" class="light" id="restart">↻ Reiniciar votação</button></div>
<div class="footer"><b>Aviso:</b> simulador de brincadeira, não oficial. Os nomes e números servem apenas para testar a interface; votos ficam só nesta página e não são enviados a nenhum órgão eleitoral.</div>
</main>
<script>
(function(){
const candidates={
 '01':{name:'ChatGPT (personagem fictício)',party:'Partido da Resenha',photo:'data:image/jpeg;base64,',label:'ChatGPT'},
 '22':{name:'Jair Bolsonaro',party:'Candidato usado para simulação',photo:'data:image/jpeg;base64,',label:'Foto ilustrativa'},
 '13':{name:'Luiz Inácio Lula da Silva',party:'Candidato usado para simulação',photo:'data:image/jpeg;base64,',label:'Foto ilustrativa'},
 '67':{name:'Capitão Clark',party:'Candidato fictício da resenha',photo:'data:image/jpeg;base64,',label:'Capitão Clark'},
 '69':{name:'Manuel Reverso',party:'Candidato fictício da resenha',photo:'data:image/jpeg;base64,',label:'Manuel Reverso'},
 '73':{name:'Manoel Gomes',party:'Candidato fictício da resenha',photo:'data:image/jpeg;base64,',label:'Manoel Gomes'}
};
let digits='',votes=[],finished=false,blank=false;
const $=id=>document.getElementById(id);
function say(t){$('message').textContent=t}
function render(){
 $('number').textContent=blank?'— —':(digits.length===0?'_ _':digits.split('').join(' '));
 const c=candidates[digits];
 $('name').textContent=blank?'VOTO EM BRANCO':(digits.length===2?(c?c.name:'Número não cadastrado'):'Digite o número');
 $('party').textContent=blank?'':('Identificação: '+(c?c.party:'—'));
 const p=$('photo');p.innerHTML='';
 if(blank){p.textContent='VOTO EM BRANCO'}
 else if(c&&c.photo){const img=document.createElement('img');img.alt='Foto ilustrativa de '+c.name;img.src=c.photo;img.onerror=()=>{p.textContent='Foto indisponível'};p.appendChild(img)}
 else if(c){p.textContent=c.label||'Candidato'}
 else p.textContent='FOTO DO\\nCANDIDATO';
 $('heading').textContent=finished?'VOTO REGISTRADO':'SEU VOTO PARA';
 $('step').textContent=finished?'OK':'TESTE';
 $('instruction').textContent=finished?'Simulação concluída. Toque em Reiniciar para votar novamente.':'Digite o número de um candidato para ver o nome e a foto.';
}
document.querySelectorAll('[data-n]').forEach(btn=>btn.addEventListener('click',()=>{
 if(finished){say('Toque em Reiniciar votação para começar novamente.');return}
 if(blank){blank=false;digits=''}
 if(digits.length>=2){say('Já tem dois algarismos. Toque CORRIGE para apagar.');return}
 digits+=btn.getAttribute('data-n');render();
 say(digits.length===2?(candidates[digits]?'Confira o nome e a foto e toque CONFIRMA.':'Número não cadastrado nesta simulação. Tente 01, 13, 22, 67, 69 ou 73.'):'Digite o segundo algarismo.');
}));
$('correct').addEventListener('click',()=>{if(finished)return;digits='';blank=false;render();say('Voto apagado. Digite novamente.')});
$('blank').addEventListener('click',()=>{if(finished)return;digits='';blank=true;render();say('Voto em branco selecionado. Toque CONFIRMA para registrar.')});
$('confirm').addEventListener('click',()=>{
 if(finished){say('Reinicie a votação para testar de novo.');return}
 if(!blank&&digits.length!==2){say('Digite dois algarismos ou selecione BRANCO.');return}
 if(!blank&&!candidates[digits]){say('Número não cadastrado. Tente 01, 13, 22, 67, 69 ou 73.');return}
 votes.push(blank?'BRANCO':digits);finished=true;render();$('help').textContent='Simulação concluída';say('Voto fictício registrado! Nenhum voto real foi enviado.');
});
$('results').addEventListener('click',()=>{
 const tally={};votes.forEach(v=>tally[v]=(tally[v]||0)+1);
 const result=Object.keys(tally).length?Object.entries(tally).map(([v,n])=>(v==='BRANCO'?'Branco':candidates[v].name+' ('+v+')')+': '+n).join(' • '):'Ainda não há votos nesta sessão.';
 say('APURAÇÃO FICTÍCIA — '+result);
});
$('restart').addEventListener('click',()=>{digits='';votes=[];finished=false;blank=false;render();$('help').innerHTML='CONFIRMA para registrar<br>CORRIGE para apagar • BRANCO para votar em branco';say('Votação reiniciada. Digite 01, 13, 22, 67, 69 ou 73.')});
render();
})();
</script>
</body></html>